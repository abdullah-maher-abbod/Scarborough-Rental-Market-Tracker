<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/User/Desktop/rental.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="125"/><column_width id="3" width="2148"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,6:mainrental"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="rental" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="300"/><column index="2" value="122"/><column index="3" value="143"/><column index="4" value="124"/><column index="5" value="136"/><column index="6" value="52"/><column index="7" value="149"/><column index="8" value="87"/><column index="9" value="115"/><column index="10" value="61"/><column index="11" value="156"/><column index="12" value="188"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT COUNT(*) FROM rental;


SELECT COUNT(*) FROM rental WHERE vacancy_rate is NULL;

UPDATE rental SET vacancy_rate = NULL WHERE vacancy_rate = '';
UPDATE rental SET rent_change_pct = NULL WHERE rent_change_pct = '';
UPDATE rental SET vacancy_quality = NULL WHERE vacancy_quality = '';
UPDATE rental SET rent_change_quality = NULL WHERE rent_change_quality = '';

select typeof(rent_change_pct), count(*) from rental group by 1;


select bedroom_type, year, avg_rent, units
from rental
where zone = 'Scarborough (Zones 10-12)'
order by bedroom_type, year;

select zone, bedroom_type, avg_rent
from rental
where year = 2025
and zone In ('Scarborough (Zones 10-12)', 'City of Toronto (Zones 1-17)')
order by bedroom_type, zone;


SELECT bedroom_type,
       MAX(CASE WHEN zone = 'Scarborough (Zones 10-12)' THEN avg_rent END) AS scarborough,
       MAX(CASE WHEN zone = 'City of Toronto (Zones 1-17)' THEN avg_rent END) AS toronto,
       MAX(CASE WHEN zone = 'City of Toronto (Zones 1-17)' THEN avg_rent END)
     - MAX(CASE WHEN zone = 'Scarborough (Zones 10-12)' THEN avg_rent END) AS gap
FROM rental
WHERE year = 2025
  AND zone IN ('Scarborough (Zones 10-12)', 'City of Toronto (Zones 1-17)')
group by bedroom_type;


select zone, avg_rent, vacancy_rate, units
from rental
where year = 2025
	and bedroom_type = 'total'
	and is_scarborough = 'True'
	and is_aggregate = 'False'
order by avg_rent DESC;


SELECT zone,
       MAX(CASE WHEN year = 2024 THEN avg_rent END) AS rent_2024,
       MAX(CASE WHEN year = 2025 THEN avg_rent END) AS rent_2025,
       ROUND((MAX(CASE WHEN year = 2025 THEN avg_rent END)
            / MAX(CASE WHEN year = 2024 THEN avg_rent END) - 1) * 100, 1) AS pct_change
FROM rental
WHERE bedroom_type = 'total'
  AND is_scarborough = 'True'
  AND is_aggregate = 'False'
GROUP BY zone;

SELECT zone, is_scarborough, vacancy_rate, rent_change_pct, avg_rent
FROM rental
WHERE year = 2025
  AND bedroom_type = 'total'
  AND is_aggregate = 'False'
  AND vacancy_rate IS NOT NULL
  AND rent_change_pct IS NOT NULL
ORDER BY vacancy_rate DESC;



SELECT zone, avg_rent, units
FROM rental
WHERE year = 2025
  AND bedroom_type = 'total'
  AND is_aggregate = 'False'
  and avg_rent is not null
ORDER BY avg_rent ASC
LIMIT 5;</sql><current_tab id="0"/></tab_sql></sqlb_project>
